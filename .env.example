# Copy to .env and fill in. See README.md "Setup" for details.

# --- Database (PostgreSQL) ---------------------------------------------------
# Local Docker Compose: postgresql://naireva:naireva@localhost:5432/naireva
# Hosted (Neon/Supabase/Railway): use the connection string they give you.
DATABASE_URL="postgresql://naireva:naireva@localhost:5432/naireva"

# --- Auth (Auth.js / NextAuth v5) --------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Object storage for private consultation photos --------------------------
# "local" (default) writes to ./storage/uploads — fine for local dev only.
# "s3" targets any S3-compatible bucket, incl. Cloudflare R2 (recommended).
STORAGE_DRIVER="local"
STORAGE_BUCKET=""
STORAGE_REGION="auto"
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# Leave empty for real AWS S3.
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Telegram notifications (recommended for launch) -------------------------
# Leave both empty and new-lead alerts just log to the console instead of
# sending, same fallback pattern as email below.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Email (optional — not required for launch) -------------------------
# Leave SMTP_HOST empty — emails are logged to the console instead of sent,
# so the consultation flow works without any mail setup. Telegram (above) is
# the primary new-lead notification channel.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="NAIREVA <no-reply@naireva.com>"
TEAM_NOTIFICATION_EMAIL="team@naireva.com"

# --- Seed script — REQUIRED in production ------------------------------------
# npm run db:seed refuses to run in production without both of these set to
# strong, unique values (see prisma/seed.ts). Not needed for local dev.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
